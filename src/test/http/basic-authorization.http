# CSRF protection is disabled in SecurityConfig (lab 4),
# so POST, PUT and DELETE no longer need a CSRF token.

### 1. GET all books - Happy Path
GET http://localhost:8080/api/v1/books
Authorization: Basic admin admin
Accept: application/json

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 2. GET one book - Happy Path
GET http://localhost:8080/api/v1/books/1
Authorization: Basic admin admin
Accept: application/json

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 3. CREATE one book - Happy Path
POST http://localhost:8080/api/v1/books
Authorization: Basic admin admin
Content-Type: application/json
Accept: application/json

{
  "title": "Tyhrolovy",
  "author": "Ivan Bahrianyi",
  "year": 1944
}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 4. UPDATE one book - Happy Path
PUT http://localhost:8080/api/v1/books
Authorization: Basic admin admin
Content-Type: application/json
Accept: application/json

{
  "id": "2",
  "title": "Lisova pisnia (updated)",
  "author": "Lesya Ukrainka",
  "year": 1911
}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 5. DELETE one book - Happy Path
DELETE http://localhost:8080/api/v1/books/3
Authorization: Basic admin admin

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 6. GET all books - Bad credentials
GET http://localhost:8080/api/v1/books
Authorization: Basic admin qwerty
Accept: application/json

> {%
    client.test("401 Unauthorized", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 7. GET one book - Bad credentials
GET http://localhost:8080/api/v1/books/1
Authorization: Basic admin qwerty
Accept: application/json

> {%
    client.test("401 Unauthorized", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 8. CREATE one book - Bad credentials
POST http://localhost:8080/api/v1/books
Authorization: Basic admin qwerty
Content-Type: application/json
Accept: application/json

{
  "title": "Should not be created",
  "author": "Hacker",
  "year": 2026
}

> {%
    client.test("401 Unauthorized", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

